# Required: the synthesizer and healer agents call the OpenAI API.
OPENAI_API_KEY=your_openai_api_key_here

# Optional — model used by both agents.
SDET_MODEL=gpt-4o-mini

# Optional — max self-healing attempts before the graph gives up.
SDET_MAX_RETRIES=3

# Optional — seconds before a generated suite is killed in the sandbox.
SDET_SANDBOX_TIMEOUT=60

# Optional — OTLP/HTTP collector endpoint (Jaeger, Tempo, Honeycomb...).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional — set to true to also dump raw spans to stdout.
OTEL_CONSOLE_EXPORT=false
